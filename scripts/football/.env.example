# Opcional: el script lee automáticamente el .env RAÍZ del proyecto.
# Solo necesitas esto si quieres sobreescribir algo localmente.

# Token (también puede ir en el .env raíz, junto a SUPABASE_DB_PASSWORD)
# FOOTBALL_DATA_API_TOKEN=

# Solo si NO usas SUPABASE_DB_PASSWORD del .env raíz:
# DATABASE_URL=postgresql://postgres.xlswyviswmgyqjcprnmb:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Temporadas: intenta desde este año (las anteriores dependen del plan API)
# FOOTBALL_SEASON_FROM=2020
# FOOTBALL_SEASON_TO=2025

# Competencias (default: PL,PD,SA,BL1,FL1,CL — Europa League EL requiere plan pago)
# FOOTBALL_COMPETITIONS=PL,PD,SA,BL1,FL1,CL
