# Copiar a .env en la raíz del proyecto (Spring Boot + scripts de ingestión leen este archivo).

# Supabase PostgreSQL (misma contraseña que usa application.properties)
SUPABASE_DB_PASSWORD=

# JWT para la API Spring
SECRET_TOKEN_JWT=

# football-data.org (registro gratuito en https://www.football-data.org/client/register)
FOOTBALL_DATA_API_TOKEN=
